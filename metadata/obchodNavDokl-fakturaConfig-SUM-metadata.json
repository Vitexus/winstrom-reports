    {
      "name": "hideEmptyAddonFields",
      "type": "boolean",
      "label": {
        "en": "Hide empty addon fields",
        "cs": "Skrýt prázdná přídavná pole",
        "sk": "Skryť prázdne dodatočné polia",
        "de": "Leere Zusatzfelder ausblenden"
      },
      "tooltip": {
        "en": "If you have added fields that are empty on the current record, then these fields will not be printed and their title will not be printed either",
        "cs": "Pokud máte přidána pole která jsou na aktuálním záznamu prázdná, tak tato pole nebudou vytistěna a nebude tisknut ani jejich titulek",
        "sk": "Pokiaľ máte pridané polia ktoré sú na aktuálnom zázname prázdne, tak tieto polia nebudú vytlačené a nebude tlačený ani ich titulok",
        "de": "Wenn Sie im aktuellen Datensatz leere Felder hinzugefügt haben, werden diese Felder nicht gedruckt und ihr Titel wird auch nicht gedruckt"
      }
    },
    {
      "name": "hidePredefinedFields",
      "type": "boolean",
      "label": {
        "en": "Hide predefined fields",
        "cs": "Skrýt předdefinovaná pole",
        "sk": "Skryť preddefinované polia",
        "de": "Vordefinierte Felder ausblenden"
      },
      "tooltip": {
        "en": "Predefined fields (dates, form of payment, account number...) will be hidden and you can define your own",
        "cs": "Předdefinovaná pole (datumy, forma úhrady, číslo účtu...) budou skryta a můžete si nadefinovat svá vlastní",
        "sk": "Preddefinované polia (dátumy, forma úhrady, číslo účtu...) budú skryté a môžete si nadefinovať svoje vlastné",
        "de": "Vordefinierte Felder (Daten, Zahlungsart, Kontonummer...) werden ausgeblendet und Sie können Ihre eigenen definieren"
      }
    },
    {
      "name": "showStampAndSignature",
      "type": "boolean",
      "label": {
        "en": "Show stamp and signature",
        "cs": "Zobrazit razítko a podpis",
        "sk": "Zobraziť pečiatku a podpis",
        "de": "Stempel und Unterschrift vorzeigen"
      },
      "tooltip": {
        "en": "Shows the stamp and signature from the company settings valid on the date of the offer",
        "cs": "Zobrazí razítko a podpis z nastavení firmy platného k datu nabídky",
        "sk": "Zobrazí pečiatku a podpis z nastavenia firmy platného k dátumu ponuky",
        "de": "Zeigt den Stempel und die Unterschrift der zum Angebotsdatum gültigen Firmeneinstellungen an"
      }
    },
    {
      "name": "showPricesBeforeDiscount",
      "type": "boolean",
      "label": {
        "en": "Show prices before discounts",
        "cs": "Zobrazit ceny před slevou",
        "sk": "Zobraziť ceny pred zľavou",
        "de": "Zeigt Preise vor Rabatt"
      },
      "tooltip": {
        "en": "Shows prices before discount and total amount before discount for receipt items",
        "cs": "Zobrazí u položek dokladu ceny před slevou a celkovou částku před slevou",
        "sk": "Zobrazí pri položkách dokladu ceny pred zľavou a celkovú čiastku pred zľavou",
        "de": "Zeigt die Preise vor Rabatt und den Gesamtbetrag vor Rabatt für Belegpositionen an"
      }
    },
    {
      "name": "hideLineOnTheSide",
      "type": "boolean",
      "label": {
        "en": "Hide vertical line on the right side",
        "cs": "Skrýt svislou čáru na pravé straně",
