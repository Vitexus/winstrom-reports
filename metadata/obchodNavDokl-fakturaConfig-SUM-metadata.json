{
  "fields": [
    {
      "name": "printPaid",
      "type": "boolean",
      "label": {
        "en": "\"PAID\" on payed documents",
        "cs": "\"UHRAZENO\" na uhrazených dokladech",
        "sk": "\"ZAPLATENÉ\" na zaplatených dokladoch",
        "de": "\"BEREITS BEZAHLT!\" auf bezahlte Quittungen"
      }
    },
    {
      "name": "addressesOnEachPage",
      "type": "boolean",
      "label": {
        "en": "Addresses on every page",
        "cs": "Adresy na každé stránce",
        "sk": "Adresy na každej strane",
        "de": "Adressen auf jeder Seite"
      },
      "tooltip": {
        "en": "Customer and supplier address will be printed on every page or only on the first page",
        "cs": "Adresa odběratele a dodavatele se bude tisknout na každé stránce nebo jen na první",
        "sk": "Adresa odberateľa a dodávateľa sa bude tlačiť na každej stránke alebo len na prvej",
        "de": "Kunden- und Lieferantenadresse werden auf jeder Seite oder nur auf der ersten Seite gedruckt"
      }
    },
    {
      "name": "switchLogoAndDocNumber",
      "type": "boolean",
      "label": {
        "en": "Logo on the left side",
        "cs": "Logo vlevo",
        "sk": "Logo na ľavej strane",
        "de": "Logo auf der linken Seite"
      },
      "tooltip": {
        "en": "The position of the logo and the document number will be swapped",
        "cs": "Dojde k prohození pozice loga a čísla dokladu",
        "sk": "Dôjde k prehodeniu pozície loga a čísla dokladu",
        "de": "Die Position des Logos und der Dokumentnummer werden vertauscht"
