				</box>
				<textElement textAlignment="Left" verticalAlignment="Bottom">
					<font size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["Číselné údaje sa zarovnávajú vpravo, ostatné údaje sa píšu zľava. Nevyplnené riadky sa ponechávajú prázdne."]]></textFieldExpression>
			</textField>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true">
				<reportElement key="textField-5" style="normal" x="0" y="66" width="535" height="13" uuid="a6548f35-4d98-40b1-a475-2e9e0d200e71"/>
