					<rightPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{_PROJEKT}.getNastaveniAPI().getOprJmeno() != null || !$P{_PROJEKT}.getNastaveniAPI().getOprJmeno().isEmpty() ? $P{_PROJEKT}.getNastaveniAPI().getOprJmeno() + " " : "")
+
($P{_PROJEKT}.getNastaveniAPI().getOprPrijmeni() != null || !$P{_PROJEKT}.getNastaveniAPI().getOprPrijmeni().isEmpty() ? $P{_PROJEKT}.getNastaveniAPI().getOprPrijmeni() + ", " : "")
+
($P{_PROJEKT}.getNastaveniAPI().getOprPostav() != null || !$P{_PROJEKT}.getNastaveniAPI().getOprPostav().isEmpty() ? $P{_PROJEKT}.getNastaveniAPI().getOprPostav() : "")]]></textFieldExpression>
