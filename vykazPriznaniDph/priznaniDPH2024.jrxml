					<font isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Údaje o podepisující osobě:"]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement key="textField-70" style="oramovane" x="6" y="590" width="524" height="15" uuid="0034944c-ec6b-49b0-8b99-d99290ca5dfa"/>
				<box leftPadding="6">
					<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA[cz.winstrom.util.WSFormatUtil.joinStringNotBlank(
" / ", new String[]{
cz.winstrom.util.WSFormatUtil.formatToShortDate(((cz.winstrom.vo.nast.Nastaveni) $P{_ADAPTER}.getNastaveni()).getZastupceDatNar()),
(((cz.winstrom.vo.nast.Nastaveni) $P{_ADAPTER}.getNastaveni()).getZastupceEvCislo()),
(((cz.winstrom.vo.nast.Nastaveni) $P{_ADAPTER}.getNastaveni()).getZastupceIc())
})]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement key="textField-71" style="normalni text" x="6" y="579" width="524" height="11" uuid="87bed0cc-dd66-460e-9103-83c36168a052"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement markup="styled">
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Datum narození / Evidenční číslo osvědčení daňového poradce / IČO právnické osoby"]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement key="textField-72" style="normalni text" x="6" y="553" width="524" height="11" uuid="bf7e2bb9-c4a2-417e-957d-f3ed15c1a0bf"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement markup="styled">
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Jméno (-a) a příjmení / Název právnické osoby"]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement key="textField-73" style="oramovane" x="6" y="564" width="524" height="15" uuid="6a0e8886-54c9-47a0-87fe-67e53aaf9e7b"/>
				<box leftPadding="6">
					<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA[cz.winstrom.util.WSFormatUtil.joinStringNotBlank(
"/", new String[]{
cz.winstrom.util.WSFormatUtil.joinStringNotBlank(
      " ", new String[] {
      (((cz.winstrom.vo.nast.Nastaveni) $P{_ADAPTER}.getNastaveni()).getZastupceJmeno()),
      (((cz.winstrom.vo.nast.Nastaveni) $P{_ADAPTER}.getNastaveni()).getZastupcePrijmeni())}),
(((cz.winstrom.vo.nast.Nastaveni) $P{_ADAPTER}.getNastaveni()).getZastupceNazev())
})]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement key="textField-74" style="normalni text" x="6" y="601" width="524" height="35" uuid="6c364b6c-9df6-447c-920c-cc96d4750d01"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement markup="styled">
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Fyzická osoba oprávněná k podpisu (je-li daňový subjekt či zástupce právnickou osobou), \n" +
"s uvedením vztahu k právnické osobě (např. jednatel, pověřený pracovník apod.)\n" +
"Jméno(-a) a příjmení / Vztah k právnické odobě"]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement key="textField-75" style="oramovane" x="6" y="636" width="524" height="15" uuid="6410aa01-926c-49e9-8852-0d12d09a457e"/>
