	<group name="aktivaPasiva">
		<groupExpression><![CDATA[($F{druhUctuK} != null && !$F{druhUctuK}.isEmpty() ? $F{druhUctuK}.substring(0, 10) : "druhUctu.aktivni".substring(0, 10))]]></groupExpression>
		<groupHeader>
			<band height="13" splitType="Stretch">
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement key="textField-145" style="ColumnHeader" isPrintRepeatedValues="false" mode="Transparent" x="0" y="0" width="178" height="13" isRemoveLineWhenBlank="true" backcolor="#E5E5E5" uuid="a737f275-9b63-4e5d-8426-d9e25649f073"/>
					<box leftPadding="2">
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement textAlignment="Left">
						<font size="10"/>
					</textElement>
					<textFieldExpression><![CDATA[($P{_IS_ROZVAHA}.booleanValue() ?
( $F{druhUctuK}.substring( 0, 10 ).equals("druhUctu.a") ?
$P{_LOCALE}.getTitle( $P{_LOCALE}.GID_REPORTS, "rozvahaVysledovkaPoUctech", "aktiva", true )
:
$P{_LOCALE}.getTitle( $P{_LOCALE}.GID_REPORTS, "rozvahaVysledovkaPoUctech", "pasiva", true )
)
:
( $F{druhUctuK}.substring( 0, 10 ).equals("druhUctu.n") ?
$P{_LOCALE}.getTitle( $P{_LOCALE}.GID_REPORTS, "rozvahaVysledovkaPoUctech", "naklady", true )
:
$P{_LOCALE}.getTitle( $P{_LOCALE}.GID_REPORTS, "rozvahaVysledovkaPoUctech", "vynosy", true )
)
)
+ " - " + $F{mena}.getKod()]]></textFieldExpression>
				</textField>
				<textField textAdjust="ScaleFont" isBlankWhenNull="true">
					<reportElement key="textField-160" style="Detail" isPrintRepeatedValues="false" mode="Transparent" x="180" y="0" width="602" height="13" isRemoveLineWhenBlank="true" backcolor="#E5E5E5" uuid="a9b076f9-9f7f-4a25-9198-f954deb4cab4"/>
